{
  "name": "ashik-small-business-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/finance.test.js",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run backend:dev\"",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "install:all": "npm install && npm --prefix backend install",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "test:legacy-ui": "node --test tests/ui.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1",
    "vite": "8.3.1",
    "concurrently": "^9.2.1"
  }
}
